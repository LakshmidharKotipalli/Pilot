{
  "manifest_version": 3,
  "name": "WebPilot Agent",
  "version": "0.1.1",
  "description": "Side-panel assistant that proposes one safe, confirmed action at a time on the page you are viewing.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel", "notifications"],
  "icons": {
    "16": "icons/webpilot-16.png",
    "32": "icons/webpilot-32.png",
    "48": "icons/webpilot-48.png",
    "128": "icons/webpilot-128.png"
  },
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Open WebPilot Agent",
    "default_icon": {
      "16": "icons/webpilot-16.png",
      "32": "icons/webpilot-32.png"
    }
  },
  "options_ui": { "page": "options/index.html", "open_in_tab": true },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
